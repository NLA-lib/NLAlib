module

public import NLAlib.Krylov.Basic.BlockSpace
public import NLAlib.Matrix.Factorizations.NystromGram
public import NLAlib.Matrix.Spectral.SingularValueInequalities

/-!
# Randomized block Krylov iteration

Randomized block Krylov iteration (RBKI) with $q$ blocks is the randomized SVD at the block Krylov
test matrix $\mathbf{K}_q(\mathbf{A}^{\mathsf{H}}\mathbf{A}, \mathbf{\Omega})$; block Krylov Nyström
(NysBKI) is Nyström at $\mathbf{K}_q(\mathbf{H}, \mathbf{\Omega})$. Both are named:
`NLAlib.rbki A Ω q`, written $\mathsf{rbki}(\mathbf{A}, \mathbf{\Omega}, q)$, and
`NLAlib.nystromBKI H Ω q`, written $\mathsf{nystromBKI}(\mathbf{H}, \mathbf{\Omega}, q)$. Randomized
subspace iteration (RSI) with $p$ power steps and its Nyström twin (NysSI) are the unnamed
compositions `rsvd A ((Aᴴ * A) ^ p * Ω)` and `nystrom H (H ^ p * Ω)`.

In Tropp and Webber's count of matrix–vector products, $\mathsf{rbki}(\mathbf{A}, \mathbf{\Omega},
q)$ uses $m = 2q$ products with $\mathbf{A}$ or $\mathbf{A}^{\mathsf{H}}$, RSI with $p$ power steps
$m = 2p + 2$, $\mathsf{nystromBKI}(\mathbf{H}, \mathbf{\Omega}, q)$ uses $m = q$ products with
$\mathbf{H}$ and NysSI with $p$ power steps $m = p + 1$. Odd counts for RBKI and RSI (the co-range
forms) are not covered.

Every deterministic lemma about `NLAlib.rsvd` applies to RBKI after `NLAlib.rbki_def`, in
particular the late-truncation API of `NLAlib.LowRank.Structural.Truncation`; late truncation is
spelled `truncatedSVD (rbki A Ω q) r`. The Krylov content of the analysis is one inequality: RBKI
with $q$ blocks beats the randomized SVD at every polynomially filtered test matrix
$f(\mathbf{A}^{\mathsf{H}}\mathbf{A})\mathbf{\Omega}$ with $\deg f < q$, singular value by singular
value (`NLAlib.singularValues_sub_rbki_le_of_degree_lt`).

## Main definitions

* `NLAlib.rbki`: randomized block Krylov iteration.
* `NLAlib.nystromBKI`: block Krylov Nyström.

## Main results

* `NLAlib.rbki_def`, `NLAlib.rbki_eq_rangeProjector`, `NLAlib.rbki_one`, `NLAlib.rbki_zero`: the
  defining formulas.
* `NLAlib.singularValues_sub_rbki_le_of_degree_lt`,
  `NLAlib.singularValues_sub_rbki_le_sub_rsvd_pow`, `NLAlib.singularValues_sub_rbki_le_of_le`: RBKI
  beats every polynomial filter, RSI with one block fewer, and itself with fewer blocks.
* `NLAlib.rbki_blockKrylovMatrix`, `Matrix.PosSemidef.nystromBKI_blockKrylovMatrix`: the simulated
  block, RBKI and NysBKI with block $\mathbf{\Omega}$ and $s + q + 1$ blocks are those with the
  block $\mathbf{K}_{s+1}$ and $q + 1$ blocks.
* `NLAlib.singularValues_sub_rbki_le_of_range_le`: a block with a larger range does at least as
  well, at the same depth.
* `NLAlib.singularValues_sub_rbki_le_of_degree_lt_of_add_le`: RBKI beats every polynomial filter
  of degree less than $d$ applied to the simulated block $\mathbf{K}_s$, for $s + d \le q + 1$.
* `NLAlib.nystromBKI_conjTranspose_mul_self`, `NLAlib.conjTranspose_mul_self_sub_nystromBKI`,
  `Matrix.PosSemidef.sub_nystromBKI_eq`: the Gram correspondence, NysBKI of $\mathbf{H}$ is RBKI of
  $\mathbf{H}^{1/2}$.
-/

@[expose] public section

open scoped Matrix ComplexOrder MatrixOrder
open Polynomial

namespace NLAlib

variable {𝕜 : Type*} [RCLike 𝕜] {l m n : Type*} [Fintype l] [Fintype m] [Fintype n]
  [DecidableEq n]


omit [Fintype m] in
/-- The range of $\mathbf{A}\,\mathbf{K}_q(\mathbf{B}, \mathbf{\Omega})$ is the image of the block
Krylov space under $\mathbf{A}$. -/
private theorem range_mul_blockKrylovMatrix (A : Matrix m n 𝕜) (B : Matrix n n 𝕜)
    (Ω : Matrix n l 𝕜) (q : ℕ) :
    LinearMap.range (A * blockKrylovMatrix B Ω q).mulVecLin =
      (blockKrylovSpace B Ω q).map A.mulVecLin := by
  rw [Matrix.mulVecLin_mul, LinearMap.range_comp, blockKrylovSpace]

/-- **Randomized block Krylov iteration** with $q$ blocks,
$$\mathsf{rbki}(\mathbf{A}, \mathbf{\Omega}, q) := \mathsf{rsvd}(\mathbf{A},
\mathbf{K}_q(\mathbf{A}^{\mathsf{H}}\mathbf{A}, \mathbf{\Omega})) =
\mathbf{P}_{\mathcal{K}_q(\mathbf{A}\mathbf{A}^{\mathsf{H}}, \mathbf{A}\mathbf{\Omega})}
\mathbf{A}\,,$$
the projection of $\mathbf{A}$ onto the block Krylov space generated by the sketch
$\mathbf{A}\mathbf{\Omega}$ (`NLAlib.rbki_eq_rangeProjector`), here deterministic. It uses
$m = 2q$ products with $\mathbf{A}$ or $\mathbf{A}^{\mathsf{H}}$ in Tropp and Webber's count. It is
$\mathbf{0}$ for $q = 0$ (`NLAlib.rbki_zero`) and the randomized SVD for $q = 1$
(`NLAlib.rbki_one`).
[TroppWebber2023, Algorithms 5.4 and 5.5]; [MuscoMusco2015, Algorithm 2]; there with a random
test matrix, an orthonormal Krylov basis and odd counts $m$ as well.
Algorithm: rbki -/
noncomputable def rbki (A : Matrix m n 𝕜) (Ω : Matrix n l 𝕜) (q : ℕ) : Matrix m n 𝕜 :=
  rsvd A (blockKrylovMatrix (Aᴴ * A) Ω q)

/-- **Block Krylov Nyström** with $q$ blocks,
$$\mathsf{nystromBKI}(\mathbf{H}, \mathbf{\Omega}, q) := \mathsf{nystrom}(\mathbf{H},
\mathbf{K}_q(\mathbf{H}, \mathbf{\Omega}))\,,$$
here deterministic; for positive semidefinite $\mathbf{H}$ it is the Gram matrix of RBKI of
$\mathbf{H}^{1/2}$ (`Matrix.PosSemidef.sub_nystromBKI_eq`). It uses $m = q$ products with
$\mathbf{H}$ in Tropp and Webber's count.
[TroppWebber2023, Algorithm 5.8]; there with a random test matrix.
Algorithm: nystrom-bki -/
noncomputable def nystromBKI (H : Matrix n n 𝕜) (Ω : Matrix n l 𝕜) (q : ℕ) : Matrix n n 𝕜 :=
  nystrom H (blockKrylovMatrix H Ω q)

/-- The defining formula,
$\mathsf{rbki}(\mathbf{A}, \mathbf{\Omega}, q) = \mathsf{rsvd}(\mathbf{A},
\mathbf{K}_q(\mathbf{A}^{\mathsf{H}}\mathbf{A}, \mathbf{\Omega}))$, the rewrite that makes every
`NLAlib.rsvd` lemma apply. -/
theorem rbki_def (A : Matrix m n 𝕜) (Ω : Matrix n l 𝕜) (q : ℕ) :
    rbki A Ω q = rsvd A (blockKrylovMatrix (Aᴴ * A) Ω q) :=
  rfl

/-- RBKI projects onto the block Krylov space of the sketch:
$$\mathsf{rbki}(\mathbf{A}, \mathbf{\Omega}, q) =
\mathbf{P}_{\mathbf{K}_q(\mathbf{A}\mathbf{A}^{\mathsf{H}}, \mathbf{A}\mathbf{\Omega})}
\mathbf{A}\,,$$
by the change of variables `NLAlib.blockKrylovMatrix_mul_mul`. [TroppWebber2023, §5.3]. -/
theorem rbki_eq_rangeProjector [DecidableEq m] (A : Matrix m n 𝕜) (Ω : Matrix n l 𝕜) (q : ℕ) :
    rbki A Ω q = rangeProjector (blockKrylovMatrix (A * Aᴴ) (A * Ω) q) * A := by
  rw [rbki, rsvd, blockKrylovMatrix_mul_mul]

/-- One block is the randomized SVD:
$\mathsf{rbki}(\mathbf{A}, \mathbf{\Omega}, 1) = \mathsf{rsvd}(\mathbf{A}, \mathbf{\Omega})$. -/
theorem rbki_one (A : Matrix m n 𝕜) (Ω : Matrix n l 𝕜) : rbki A Ω 1 = rsvd A Ω := by
  rw [rbki, rsvd, rsvd]
  congr 1
  refine rangeProjector_inj.mpr ?_
  rw [range_mul_blockKrylovMatrix, blockKrylovSpace_one, Matrix.mulVecLin_mul,
    LinearMap.range_comp]

/-- No block gives the zero matrix: $\mathsf{rbki}(\mathbf{A}, \mathbf{\Omega}, 0) = \mathbf{0}$. -/
@[simp]
theorem rbki_zero (A : Matrix m n 𝕜) (Ω : Matrix n l 𝕜) : rbki A Ω 0 = 0 := by
  rw [rbki, rsvd, Subsingleton.elim (A * blockKrylovMatrix (Aᴴ * A) Ω 0) 0, rangeProjector_zero,
    Matrix.zero_mul]

/-- **RBKI beats every polynomial filter**: for a polynomial $f$ of degree less than $q$, with
coefficients in any subfield (in particular real), and every $i$,
$$\sigma_i(\mathbf{A} - \mathsf{rbki}(\mathbf{A}, \mathbf{\Omega}, q)) \le
\sigma_i(\mathbf{A} - \mathsf{rsvd}(\mathbf{A},
f(\mathbf{A}^{\mathsf{H}}\mathbf{A})\mathbf{\Omega}))\,,$$
so in every unitarily invariant norm: the range of
$\mathbf{A}f(\mathbf{A}^{\mathsf{H}}\mathbf{A})\mathbf{\Omega}$ lies in that of
$\mathbf{A}\mathbf{K}_q(\mathbf{A}^{\mathsf{H}}\mathbf{A}, \mathbf{\Omega})$. This is the whole
Krylov content of the analysis of RBKI.
[TroppWebber2023, §9.3 (proof of Theorem 9.1)]; [MuscoMusco2015, Lemma 5 (use)]. -/
theorem singularValues_sub_rbki_le_of_degree_lt {R : Type*} [CommSemiring R] [Algebra R 𝕜]
    (A : Matrix m n 𝕜) (Ω : Matrix n l 𝕜) {q : ℕ} {f : R[X]} (hf : f.degree < q) (i : ℕ) :
    singularValues (A - rbki A Ω q) i ≤ singularValues (A - rsvd A (aeval (Aᴴ * A) f * Ω)) i := by
  classical
  rw [rbki, sub_rsvd, sub_rsvd]
  refine singularValues_one_sub_rangeProjector_mul_le_of_range_le ?_ A i
  rw [← Matrix.mul_assoc]
  exact range_mul_aeval_mul_le_range_mul_blockKrylovMatrix A (Aᴴ * A) Ω hf

/-- **RBKI beats RSI with one block fewer**: with $p$ power steps,
$$\sigma_i(\mathbf{A} - \mathsf{rbki}(\mathbf{A}, \mathbf{\Omega}, p + 1)) \le
\sigma_i(\mathbf{A} - \mathsf{rsvd}(\mathbf{A},
(\mathbf{A}^{\mathsf{H}}\mathbf{A})^p\mathbf{\Omega}))$$
for every $i$; the two use $2p + 2$ products. [TroppWebber2023, §5.3]. -/
theorem singularValues_sub_rbki_le_sub_rsvd_pow (A : Matrix m n 𝕜) (Ω : Matrix n l 𝕜) (p i : ℕ) :
    singularValues (A - rbki A Ω (p + 1)) i ≤
      singularValues (A - rsvd A ((Aᴴ * A) ^ p * Ω)) i := by
  have h := singularValues_sub_rbki_le_of_degree_lt A Ω (q := p + 1) (f := (X : 𝕜[X]) ^ p)
    (by rw [degree_X_pow]; exact_mod_cast p.lt_succ_self) i
  rwa [aeval_X_pow] at h

/-- More blocks, smaller error: for $q \le q'$ and every $i$,
$$\sigma_i(\mathbf{A} - \mathsf{rbki}(\mathbf{A}, \mathbf{\Omega}, q')) \le
\sigma_i(\mathbf{A} - \mathsf{rbki}(\mathbf{A}, \mathbf{\Omega}, q))\,.$$ -/
theorem singularValues_sub_rbki_le_of_le (A : Matrix m n 𝕜) (Ω : Matrix n l 𝕜) {q q' : ℕ}
    (h : q ≤ q') (i : ℕ) :
    singularValues (A - rbki A Ω q') i ≤ singularValues (A - rbki A Ω q) i := by
  classical
  rw [rbki, rbki, sub_rsvd, sub_rsvd]
  refine singularValues_one_sub_rangeProjector_mul_le_of_range_le ?_ A i
  rw [range_mul_blockKrylovMatrix, range_mul_blockKrylovMatrix]
  exact Submodule.map_mono (blockKrylovSpace_mono _ _ h)

/-! ### The simulated block -/

/-- **The simulated block of RBKI**: with $\mathbf{H} = \mathbf{A}^{\mathsf{H}}\mathbf{A}$ and
every $s, q \ge 0$,
$$\mathsf{rbki}(\mathbf{A}, \mathbf{K}_{s+1}(\mathbf{H}, \mathbf{\Omega}), q + 1) =
\mathsf{rbki}(\mathbf{A}, \mathbf{\Omega}, s + q + 1)\,:$$
RBKI with block $\mathbf{\Omega}$ and $s + q + 1$ blocks is RBKI with the simulated block
$[\mathbf{\Omega}, \mathbf{H}\mathbf{\Omega}, \dots, \mathbf{H}^{s}\mathbf{\Omega}]$ and
$q + 1$ blocks, so a bound for wide blocks applies to narrow ones at larger depth.
[MeyerMuscoMusco2023, §3.1], there for one start vector and a positive semidefinite matrix, as an
equality of Krylov subspaces; [ChenEpperlyMeyerMuscoRao2025, Observation 3.3], there as an
equality of block Krylov subspaces; here as an equality of the approximations.
Result: rbki-simulated-block -/
theorem rbki_blockKrylovMatrix (A : Matrix m n 𝕜) (Ω : Matrix n l 𝕜) (s q : ℕ) :
    rbki A (blockKrylovMatrix (Aᴴ * A) Ω (s + 1)) (q + 1) = rbki A Ω (s + q + 1) := by
  rw [rbki, rbki, rsvd, rsvd]
  congr 1
  refine rangeProjector_inj.mpr ?_
  rw [range_mul_blockKrylovMatrix, range_mul_blockKrylovMatrix,
    blockKrylovSpace_blockKrylovMatrix]

/-- **The simulated block of block Krylov Nyström**: for positive semidefinite $\mathbf{H}$ and
every $s, q \ge 0$,
$$\mathsf{nystromBKI}(\mathbf{H}, \mathbf{K}_{s+1}(\mathbf{H}, \mathbf{\Omega}), q + 1) =
\mathsf{nystromBKI}(\mathbf{H}, \mathbf{\Omega}, s + q + 1)\,,$$
since the Nyström approximation of a positive semidefinite matrix depends on the test matrix only
through its range.
[ChenEpperlyMeyerMuscoRao2025, Observation 3.3], there the equality of the two block Krylov
subspaces; the statement for the Nyström approximation is not printed there.
Result: nystrom-bki-simulated-block -/
theorem _root_.Matrix.PosSemidef.nystromBKI_blockKrylovMatrix {H : Matrix n n 𝕜}
    (hH : H.PosSemidef) (Ω : Matrix n l 𝕜) (s q : ℕ) :
    nystromBKI H (blockKrylovMatrix H Ω (s + 1)) (q + 1) = nystromBKI H Ω (s + q + 1) :=
  hH.nystrom_eq_of_range_eq (blockKrylovSpace_blockKrylovMatrix H Ω s q)

/-- **A block with a larger range does at least as well**: if the range of $\mathbf{\Omega}'$
lies in the range of $\mathbf{\Omega}$ (a sub-block, or any column combinations), then for every
number of blocks $q$ and every $i$,
$$\sigma_i(\mathbf{A} - \mathsf{rbki}(\mathbf{A}, \mathbf{\Omega}, q)) \le
\sigma_i(\mathbf{A} - \mathsf{rbki}(\mathbf{A}, \mathbf{\Omega}', q))\,,$$
so in every unitarily invariant norm.
No printed source.
Result: rbki-block-monotonicity -/
theorem singularValues_sub_rbki_le_of_range_le {l' : Type*} [Fintype l'] (A : Matrix m n 𝕜)
    {Ω : Matrix n l 𝕜} {Ω' : Matrix n l' 𝕜}
    (h : LinearMap.range Ω'.mulVecLin ≤ LinearMap.range Ω.mulVecLin) (q i : ℕ) :
    singularValues (A - rbki A Ω q) i ≤ singularValues (A - rbki A Ω' q) i := by
  classical
  rw [rbki, rbki, sub_rsvd, sub_rsvd]
  refine singularValues_one_sub_rangeProjector_mul_le_of_range_le ?_ A i
  rw [range_mul_blockKrylovMatrix, range_mul_blockKrylovMatrix]
  exact Submodule.map_mono (blockKrylovSpace_le_of_range_le h q)

/-- **RBKI beats every polynomial filter of the simulated block**: with
$\mathbf{H} = \mathbf{A}^{\mathsf{H}}\mathbf{A}$, for a polynomial $f$ of degree less than $d$,
with coefficients in any subfield (in particular real), a simulated block of $s$ blocks with
$s + d \le q + 1$, and every $i$,
$$\sigma_i(\mathbf{A} - \mathsf{rbki}(\mathbf{A}, \mathbf{\Omega}, q)) \le
\sigma_i(\mathbf{A} - \mathsf{rsvd}(\mathbf{A},
f(\mathbf{H})\,\mathbf{K}_s(\mathbf{H}, \mathbf{\Omega})))\,,$$
so in every unitarily invariant norm: the columns of
$f(\mathbf{H})\mathbf{K}_s(\mathbf{H}, \mathbf{\Omega})$ are polynomials of degree at most
$s + d - 2 < q$ in $\mathbf{H}$ applied to the columns of $\mathbf{\Omega}$. At $s = 1$,
$d = q$ it is the bound for filters of $\mathbf{\Omega}$ itself; $s = 0$ and $d = 0$ are allowed
and give $\sigma_i(\mathbf{A})$ on the right.
[MeyerMuscoMusco2023, §3.1], the argument, not the statement: there the analysis of block Krylov
iteration is applied to the simulated block of one start vector. -/
theorem singularValues_sub_rbki_le_of_degree_lt_of_add_le {R : Type*} [CommSemiring R]
    [Algebra R 𝕜] (A : Matrix m n 𝕜) (Ω : Matrix n l 𝕜) {q s d : ℕ} {f : R[X]}
    (hf : f.degree < d) (hsd : s + d ≤ q + 1) (i : ℕ) :
    singularValues (A - rbki A Ω q) i ≤
      singularValues (A - rsvd A (aeval (Aᴴ * A) f * blockKrylovMatrix (Aᴴ * A) Ω s)) i := by
  classical
  rw [rbki, sub_rsvd, sub_rsvd]
  refine singularValues_one_sub_rangeProjector_mul_le_of_range_le ?_ A i
  rw [range_mul_blockKrylovMatrix, Matrix.mulVecLin_mul, LinearMap.range_comp]
  refine Submodule.map_mono ?_
  rcases s with _ | s
  · rw [Matrix.range_mulVecLin, Set.range_eq_empty, Submodule.span_empty]
    exact bot_le
  rcases d with _ | d
  · rw [Nat.cast_zero, Nat.WithBot.lt_zero_iff, degree_eq_bot] at hf
    rw [hf, map_zero, Matrix.zero_mul, Matrix.mulVecLin_zero, LinearMap.range_zero]
    exact bot_le
  refine (range_aeval_mul_le_blockKrylovSpace (Aᴴ * A) _ hf).trans ?_
  rw [blockKrylovSpace_blockKrylovMatrix]
  exact blockKrylovSpace_mono _ _ (by omega)

/-! ### Block Krylov Nyström through the Gram correspondence -/

/-- **The Gram correspondence for block Krylov Nyström**: NysBKI of
$\mathbf{F}^{\mathsf{H}}\mathbf{F}$ is the Gram matrix of RBKI of $\mathbf{F}$,
$$\mathsf{nystromBKI}(\mathbf{F}^{\mathsf{H}}\mathbf{F}, \mathbf{\Omega}, q) =
\mathsf{rbki}(\mathbf{F}, \mathbf{\Omega}, q)^{\mathsf{H}}\,\mathsf{rbki}(\mathbf{F},
\mathbf{\Omega}, q)\,.$$
[TroppWebber2023, §5.4]; there for $\mathbf{F} = \mathbf{H}^{1/2}$.
Result: gram-correspondence -/
theorem nystromBKI_conjTranspose_mul_self (F : Matrix m n 𝕜) (Ω : Matrix n l 𝕜) (q : ℕ) :
    nystromBKI (Fᴴ * F) Ω q = (rbki F Ω q)ᴴ * rbki F Ω q :=
  nystrom_conjTranspose_mul_self F _

/-- **The Gram correspondence for block Krylov Nyström, error form**:
$$\mathbf{F}^{\mathsf{H}}\mathbf{F} - \mathsf{nystromBKI}(\mathbf{F}^{\mathsf{H}}\mathbf{F},
\mathbf{\Omega}, q) = \mathbf{E}^{\mathsf{H}}\mathbf{E}, \qquad
\mathbf{E} = \mathbf{F} - \mathsf{rbki}(\mathbf{F}, \mathbf{\Omega}, q)\,.$$
[TroppWebber2023, §5.4]; there for $\mathbf{F} = \mathbf{H}^{1/2}$.
Result: gram-correspondence -/
theorem conjTranspose_mul_self_sub_nystromBKI (F : Matrix m n 𝕜) (Ω : Matrix n l 𝕜) (q : ℕ) :
    Fᴴ * F - nystromBKI (Fᴴ * F) Ω q = (F - rbki F Ω q)ᴴ * (F - rbki F Ω q) :=
  conjTranspose_mul_self_sub_nystrom F _

/-- **The Gram correspondence for block Krylov Nyström of a positive semidefinite matrix**: the
error of NysBKI is the Gram matrix of the error of RBKI of the square root,
$$\mathbf{H} - \mathsf{nystromBKI}(\mathbf{H}, \mathbf{\Omega}, q) =
\mathbf{E}^{\mathsf{H}}\mathbf{E}, \qquad
\mathbf{E} = \mathbf{H}^{1/2} - \mathsf{rbki}(\mathbf{H}^{1/2}, \mathbf{\Omega}, q)\,;$$
NysBKI with $q$ products with $\mathbf{H}$ is RBKI with $2q$ products with $\mathbf{H}^{1/2}$.
NysSI needs no twin: `Matrix.PosSemidef.sub_nystrom_eq` at the test matrix
$\mathbf{H}^p\mathbf{\Omega}$ is RSI of $\mathbf{H}^{1/2}$ with $p$ power steps.
[TroppWebber2023, §5.4].
Result: gram-correspondence -/
theorem _root_.Matrix.PosSemidef.sub_nystromBKI_eq {H : Matrix n n 𝕜} (hH : H.PosSemidef)
    (Ω : Matrix n l 𝕜) (q : ℕ) :
    H - nystromBKI H Ω q =
      (CFC.sqrt H - rbki (CFC.sqrt H) Ω q)ᴴ * (CFC.sqrt H - rbki (CFC.sqrt H) Ω q) := by
  have hR : (CFC.sqrt H)ᴴ = CFC.sqrt H :=
    (Matrix.nonneg_iff_posSemidef.mp (CFC.sqrt_nonneg H)).isHermitian.eq
  have hH' : H = (CFC.sqrt H)ᴴ * CFC.sqrt H := by
    rw [hR, CFC.sqrt_mul_sqrt_self H hH.nonneg]
  conv_lhs => rw [hH']
  exact conjTranspose_mul_self_sub_nystromBKI (CFC.sqrt H) Ω q

end NLAlib
