public import NLAlib.LowRank.Structural.RitzValues
public import NLAlib.LowRank.Structural.SingularValueDeficit
public import NLAlib.Probability.Measurability.Krylov
public import NLAlib.Probability.Measurability.Matrix

/-!
# Block Krylov iteration on the sum of two block Krylov spaces

The randomized SVD at the two block Krylov test matrices
$\mathbf{K}_{q_1}(\mathbf{A}^{\mathsf{H}}\mathbf{A}, \mathbf{\Omega}_1)$ and
$\mathbf{K}_{q_2}(\mathbf{A}^{\mathsf{H}}\mathbf{A}, \mathbf{\Omega}_2)$ side by side is named
`NLAlib.rbkiSum A Ω₁ Ω₂ q₁ q₂`, written
$\mathsf{rbkiSum}(\mathbf{A}, \mathbf{\Omega}_1, \mathbf{\Omega}_2, q_1, q_2)$: the projection of
$\mathbf{A}$ onto the sum of the two block Krylov spaces generated by
$\mathbf{A}\mathbf{\Omega}_1$ and $\mathbf{A}\mathbf{\Omega}_2$. A narrow block
$\mathbf{\Omega}_1$ run deep and a wide block $\mathbf{\Omega}_2$ run shallow are the two runs of
[BakshiClarksonWoodruff2022]; projecting onto the sum of the two spaces needs no rule for
selecting one of them, since the singular values of the compression only grow with the space.

The error bounds are deterministic and are stated for $\mathsf{rsvd}(\mathbf{A}, \mathbf{Y})$ at
any test matrix $\mathbf{Y}$ whose sketch $\mathbf{A}\mathbf{Y}$ contains both block Krylov
sketches in its range; $\mathsf{rbkiSum}$ is one instance. Each run enters through a frame of
right singular vectors and its residual, as in `NLAlib.LowRank.Structural.RitzValues`: the
narrow run through $\llbracket\mathbf{A}\rrbracket_k$ with no gap, the wide run through
$\llbracket\mathbf{A}\rrbracket_{k+j}$ and the gap between $\sigma_{k-1}$ and $\sigma_{k+j}$.

## Main definitions

* `NLAlib.rbkiSum`: block Krylov iteration on the sum of two block Krylov spaces.

## Main results

* `NLAlib.rbkiSum_def`, `NLAlib.rbkiSum_eq_rangeProjector`: the defining formulas.
* `NLAlib.measurable_rbkiSum`: measurability in the pair of test matrices.
* `NLAlib.range_mul_blockKrylovMatrix_le_range_mul_fromCols_left`,
  `NLAlib.range_mul_blockKrylovMatrix_le_range_mul_fromCols_right`,
  `NLAlib.singularValues_rbki_le_singularValues_rbkiSum_left`,
  `NLAlib.singularValues_rbki_le_singularValues_rbkiSum_right`: the sum contains each run.
* `NLAlib.HasOrthonormalCols.frobNorm_sub_truncatedSVD_rsvd_sq_le_of_range_le`,
  `NLAlib.HasOrthonormalCols.frobNorm_sub_truncatedSVD_rbkiSum_sq_le`: the Frobenius error of
  the truncated output.
* `NLAlib.HasOrthonormalCols.min_frobNorm_sub_truncatedSVD_rbki_sq_le`: the better of the two
  runs, Frobenius norm.
* `NLAlib.HasOrthonormalCols.schattenNorm_sub_mul_rangeProjector_rsvd_rpow_le_of_range_le`,
  `NLAlib.HasOrthonormalCols.schattenNorm_sub_mul_rangeProjector_rbkiSum_rpow_le`: the Schatten
  error of the two-sided output, $1 \le p \le 2$.
-/

@[expose] public section

open scoped Matrix ENNReal

namespace NLAlib

variable {𝕜 : Type*} [RCLike 𝕜] {l l₁ l₂ m n s₁ s₂ : Type*} [Fintype l] [Fintype l₁] [Fintype l₂]
  [Fintype m] [Fintype n] [Fintype s₁] [Fintype s₂] [DecidableEq m] [DecidableEq n]
  [DecidableEq s₁] [DecidableEq s₂]

/-! ### The definition -/

/-- **Block Krylov iteration on the sum of two block Krylov spaces**, with $q_1$ blocks from
$\mathbf{\Omega}_1$ and $q_2$ blocks from $\mathbf{\Omega}_2$,
$$\mathsf{rbkiSum}(\mathbf{A}, \mathbf{\Omega}_1, \mathbf{\Omega}_2, q_1, q_2) :=
\mathsf{rsvd}\bigl(\mathbf{A}, \begin{bmatrix}
\mathbf{K}_{q_1}(\mathbf{A}^{\mathsf{H}}\mathbf{A}, \mathbf{\Omega}_1) &
\mathbf{K}_{q_2}(\mathbf{A}^{\mathsf{H}}\mathbf{A}, \mathbf{\Omega}_2)\end{bmatrix}\bigr)\,,$$
the projection of $\mathbf{A}$ onto the sum of the block Krylov spaces generated by the sketches
$\mathbf{A}\mathbf{\Omega}_1$ and $\mathbf{A}\mathbf{\Omega}_2$
(`NLAlib.rbkiSum_eq_rangeProjector`), here deterministic.
[BakshiClarksonWoodruff2022, Algorithm 3.2]; there one of the two block Krylov runs is selected
from estimated singular values, here the output is the projection onto the sum of the two
spaces and nothing is selected.
Algorithm: rbki-sum -/
noncomputable def rbkiSum (A : Matrix m n 𝕜) (Ω₁ : Matrix n l₁ 𝕜) (Ω₂ : Matrix n l₂ 𝕜)
    (q₁ q₂ : ℕ) : Matrix m n 𝕜 :=
  rsvd A (Matrix.fromCols (blockKrylovMatrix (Aᴴ * A) Ω₁ q₁) (blockKrylovMatrix (Aᴴ * A) Ω₂ q₂))

omit [DecidableEq m] in
/-- The defining formula of
$\mathsf{rbkiSum}(\mathbf{A}, \mathbf{\Omega}_1, \mathbf{\Omega}_2, q_1, q_2)$: the randomized
SVD at the two block Krylov test matrices side by side, the rewrite that makes every
`NLAlib.rsvd` lemma apply. -/
theorem rbkiSum_def (A : Matrix m n 𝕜) (Ω₁ : Matrix n l₁ 𝕜) (Ω₂ : Matrix n l₂ 𝕜) (q₁ q₂ : ℕ) :
    rbkiSum A Ω₁ Ω₂ q₁ q₂ = rsvd A (Matrix.fromCols (blockKrylovMatrix (Aᴴ * A) Ω₁ q₁)
      (blockKrylovMatrix (Aᴴ * A) Ω₂ q₂)) := rfl

/-- $\mathsf{rbkiSum}(\mathbf{A}, \mathbf{\Omega}_1, \mathbf{\Omega}_2, q_1, q_2)$ is the
projection of $\mathbf{A}$ onto the sum of the block Krylov spaces
$\mathcal{K}_{q_1}(\mathbf{A}\mathbf{A}^{\mathsf{H}}, \mathbf{A}\mathbf{\Omega}_1)$ and
$\mathcal{K}_{q_2}(\mathbf{A}\mathbf{A}^{\mathsf{H}}, \mathbf{A}\mathbf{\Omega}_2)$, the range of
the two block Krylov matrices of $\mathbf{A}\mathbf{A}^{\mathsf{H}}$ side by side. -/
theorem rbkiSum_eq_rangeProjector (A : Matrix m n 𝕜) (Ω₁ : Matrix n l₁ 𝕜) (Ω₂ : Matrix n l₂ 𝕜)
    (q₁ q₂ : ℕ) :
    rbkiSum A Ω₁ Ω₂ q₁ q₂ = rangeProjector (Matrix.fromCols
      (blockKrylovMatrix (A * Aᴴ) (A * Ω₁) q₁) (blockKrylovMatrix (A * Aᴴ) (A * Ω₂) q₂)) * A := by
  rw [rbkiSum, rsvd, Matrix.mul_fromCols, blockKrylovMatrix_mul_mul, blockKrylovMatrix_mul_mul]

omit [DecidableEq m] in
/-- Block Krylov iteration on the sum of two block Krylov spaces,
$(\mathbf{\Omega}_1, \mathbf{\Omega}_2) \mapsto \mathsf{rbkiSum}(\mathbf{A}, \mathbf{\Omega}_1,
\mathbf{\Omega}_2, q_1, q_2)$, is a measurable function of the two test matrices. -/
theorem measurable_rbkiSum (A : Matrix m n 𝕜) (q₁ q₂ : ℕ) :
    Measurable fun Ω : Matrix n l₁ 𝕜 × Matrix n l₂ 𝕜 => rbkiSum A Ω.1 Ω.2 q₁ q₂ :=
  (measurable_rsvd A).comp (measurable_fromCols_blockKrylovMatrix (Aᴴ * A) q₁ q₂)

/-! ### The sum contains each run -/

omit [DecidableEq m] in
/-- The sketch of the two block Krylov test matrices side by side contains the sketch of the
first: the range of $\mathbf{A}\mathbf{K}_{q_1}(\mathbf{A}^{\mathsf{H}}\mathbf{A},
\mathbf{\Omega}_1)$ is contained in the range of $\mathbf{A}\begin{bmatrix}
\mathbf{K}_{q_1}(\mathbf{A}^{\mathsf{H}}\mathbf{A}, \mathbf{\Omega}_1) &
\mathbf{K}_{q_2}(\mathbf{A}^{\mathsf{H}}\mathbf{A}, \mathbf{\Omega}_2)\end{bmatrix}$. It
discharges the first range hypothesis of the theorems about a sketch containing both block
Krylov sketches. -/
theorem range_mul_blockKrylovMatrix_le_range_mul_fromCols_left (A : Matrix m n 𝕜)
    (Ω₁ : Matrix n l₁ 𝕜) (Ω₂ : Matrix n l₂ 𝕜) (q₁ q₂ : ℕ) :
    LinearMap.range (A * blockKrylovMatrix (Aᴴ * A) Ω₁ q₁).mulVecLin ≤
      LinearMap.range (A * Matrix.fromCols (blockKrylovMatrix (Aᴴ * A) Ω₁ q₁)
        (blockKrylovMatrix (Aᴴ * A) Ω₂ q₂)).mulVecLin := by
  rw [Matrix.mul_fromCols]
  exact Matrix.range_le_range_fromCols_left _ _

omit [DecidableEq m] in
/-- The sketch of the two block Krylov test matrices side by side contains the sketch of the
second: the range of $\mathbf{A}\mathbf{K}_{q_2}(\mathbf{A}^{\mathsf{H}}\mathbf{A},
\mathbf{\Omega}_2)$ is contained in the range of $\mathbf{A}\begin{bmatrix}
\mathbf{K}_{q_1}(\mathbf{A}^{\mathsf{H}}\mathbf{A}, \mathbf{\Omega}_1) &
\mathbf{K}_{q_2}(\mathbf{A}^{\mathsf{H}}\mathbf{A}, \mathbf{\Omega}_2)\end{bmatrix}$. It
discharges the second range hypothesis of the theorems about a sketch containing both block
Krylov sketches. -/
theorem range_mul_blockKrylovMatrix_le_range_mul_fromCols_right (A : Matrix m n 𝕜)
    (Ω₁ : Matrix n l₁ 𝕜) (Ω₂ : Matrix n l₂ 𝕜) (q₁ q₂ : ℕ) :
    LinearMap.range (A * blockKrylovMatrix (Aᴴ * A) Ω₂ q₂).mulVecLin ≤
      LinearMap.range (A * Matrix.fromCols (blockKrylovMatrix (Aᴴ * A) Ω₁ q₁)
        (blockKrylovMatrix (Aᴴ * A) Ω₂ q₂)).mulVecLin := by
  rw [Matrix.mul_fromCols]
  exact Matrix.range_le_range_fromCols_right _ _

omit [DecidableEq m] in
/-- The sum does at least as well as the first run, singular value by singular value:
$\sigma_i\bigl(\mathsf{rbki}(\mathbf{A}, \mathbf{\Omega}_1, q_1)\bigr) \le
\sigma_i\bigl(\mathsf{rbkiSum}(\mathbf{A}, \mathbf{\Omega}_1, \mathbf{\Omega}_2, q_1,
q_2)\bigr)$ for every $i$. -/
theorem singularValues_rbki_le_singularValues_rbkiSum_left (A : Matrix m n 𝕜)
    (Ω₁ : Matrix n l₁ 𝕜) (Ω₂ : Matrix n l₂ 𝕜) (q₁ q₂ i : ℕ) :
    singularValues (rbki A Ω₁ q₁) i ≤ singularValues (rbkiSum A Ω₁ Ω₂ q₁ q₂) i := by
  classical
  exact singularValues_rangeProjector_mul_le_of_range_le
    (range_mul_blockKrylovMatrix_le_range_mul_fromCols_left A Ω₁ Ω₂ q₁ q₂) A i

omit [DecidableEq m] in
/-- The sum does at least as well as the second run, singular value by singular value:
$\sigma_i\bigl(\mathsf{rbki}(\mathbf{A}, \mathbf{\Omega}_2, q_2)\bigr) \le
\sigma_i\bigl(\mathsf{rbkiSum}(\mathbf{A}, \mathbf{\Omega}_1, \mathbf{\Omega}_2, q_1,
q_2)\bigr)$ for every $i$. -/
theorem singularValues_rbki_le_singularValues_rbkiSum_right (A : Matrix m n 𝕜)
    (Ω₁ : Matrix n l₁ 𝕜) (Ω₂ : Matrix n l₂ 𝕜) (q₁ q₂ i : ℕ) :
    singularValues (rbki A Ω₂ q₂) i ≤ singularValues (rbkiSum A Ω₁ Ω₂ q₁ q₂) i := by
  classical
  exact singularValues_rangeProjector_mul_le_of_range_le
    (range_mul_blockKrylovMatrix_le_range_mul_fromCols_right A Ω₁ Ω₂ q₁ q₂) A i

/-! ### Frobenius norm -/

omit [DecidableEq m] in
/-- **The Frobenius error of a sketch containing two block Krylov sketches**: let
$\mathbf{Z}_1$, $\mathbf{Z}_2$ be frames (orthonormal columns) with
$\mathbf{A}\mathbf{Z}_1\mathbf{Z}_1^{\mathsf{H}} = \llbracket\mathbf{A}\rrbracket_k$,
$\mathbf{A}\mathbf{Z}_2\mathbf{Z}_2^{\mathsf{H}} = \llbracket\mathbf{A}\rrbracket_{k+j}$ and
$\operatorname{rank}(\mathbf{\Omega}_a^{\mathsf{H}}\mathbf{Z}_a) =
\operatorname{rank}\mathbf{Z}_a$ for $a = 1, 2$, let $q_1, q_2 \ge 1$ and $0 < \gamma \le 1$,
and let $\mathbf{Y}$ be a test matrix such that the range of $\mathbf{A}\mathbf{Y}$ contains the
ranges of $\mathbf{A}\mathbf{K}_{q_1}(\mathbf{A}^{\mathsf{H}}\mathbf{A}, \mathbf{\Omega}_1)$ and
of $\mathbf{A}\mathbf{K}_{q_2}(\mathbf{A}^{\mathsf{H}}\mathbf{A}, \mathbf{\Omega}_2)$. Then
$$\begin{aligned}
\|\mathbf{A} - \llbracket\mathsf{rsvd}(\mathbf{A}, \mathbf{Y})\rrbracket_k\|_{\mathsf{F}}^2 \le{}&
\Bigl(1 + \frac{2k\gamma}{j + 1}\Bigr)
\|\mathbf{A} - \llbracket\mathbf{A}\rrbracket_k\|_{\mathsf{F}}^2 +
4k\,e^{-2\sqrt{2}(q_1-1)\sqrt{\gamma}}\,
\|(\mathbf{A} - \llbracket\mathbf{A}\rrbracket_k)\mathbf{\Omega}_1
(\mathbf{Z}_1^{\mathsf{H}}\mathbf{\Omega}_1)^{+}\|_2^2 \\
&+ 4e^{-3(q_2-1)}\,
\|(\mathbf{A} - \llbracket\mathbf{A}\rrbracket_{k+j})\mathbf{\Omega}_2
(\mathbf{Z}_2^{\mathsf{H}}\mathbf{\Omega}_2)^{+}\|_{\mathsf{F}}^2\,.
\end{aligned}$$
If $\sigma_k \le \sqrt{2}\,\sigma_{k+j}$ the tail is heavy and the first run suffices; otherwise
there is a gap between $\sigma_{k-1}$ and $\sigma_{k+j}$ and the second run captures the head.
[BakshiClarksonWoodruff2022, Theorem 3.1]; there at $p = 2$ for an algorithm that selects one of
the two runs, with blocks of $k$ and $s$ columns, probability $9/10$ and unspecified constants;
here deterministic, for any sketch containing both block Krylov sketches, with the two
residuals explicit. -/
theorem HasOrthonormalCols.frobNorm_sub_truncatedSVD_rsvd_sq_le_of_range_le
    {A : Matrix m n 𝕜} {Ω₁ : Matrix n l₁ 𝕜} {Ω₂ : Matrix n l₂ 𝕜} {Z₁ : Matrix n s₁ 𝕜}
    {Z₂ : Matrix n s₂ 𝕜} (hZ₁ : HasOrthonormalCols Z₁) (hZ₂ : HasOrthonormalCols Z₂)
    (hΩ₁ : (Ω₁ᴴ * Z₁).rank = Z₁.rank) (hΩ₂ : (Ω₂ᴴ * Z₂).rank = Z₂.rank) {k j : ℕ}
    (hAZ₁ : A * Z₁ * Z₁ᴴ = truncatedSVD A k) (hAZ₂ : A * Z₂ * Z₂ᴴ = truncatedSVD A (k + j))
    {q₁ q₂ : ℕ} (hq₁ : 1 ≤ q₁) (hq₂ : 1 ≤ q₂) {γ : ℝ} (hγ : 0 < γ) (hγ1 : γ ≤ 1)
    {Y : Matrix n l 𝕜}
    (h₁ : LinearMap.range (A * blockKrylovMatrix (Aᴴ * A) Ω₁ q₁).mulVecLin ≤
      LinearMap.range (A * Y).mulVecLin)
    (h₂ : LinearMap.range (A * blockKrylovMatrix (Aᴴ * A) Ω₂ q₂).mulVecLin ≤
      LinearMap.range (A * Y).mulVecLin) :
    frobNorm (A - truncatedSVD (rsvd A Y) k) ^ 2 ≤
      (1 + 2 * k * γ / ((j : ℝ) + 1)) * frobNorm (A - truncatedSVD A k) ^ 2 +
        4 * k * Real.exp (-2 * Real.sqrt 2 * ((q₁ : ℝ) - 1) * Real.sqrt γ) *
          specNorm ((A - truncatedSVD A k) * Ω₁ * pinv (Z₁ᴴ * Ω₁)) ^ 2 +
        4 * Real.exp (-3 * ((q₂ : ℝ) - 1)) *
          frobNorm ((A - truncatedSVD A (k + j)) * Ω₂ * pinv (Z₂ᴴ * Ω₂)) ^ 2 := sorry

