      (1 + 2 * k * γ / ((j : ℝ) + 1)) * schattenNorm p (A - truncatedSVD A k) ^ p.toReal +
        singularValues A k ^ (p.toReal - 2) *
          (4 * k * Real.exp (-2 * Real.sqrt 2 * ((q₁ : ℝ) - 1) * Real.sqrt γ) *
              specNorm ((A - truncatedSVD A k) * Ω₁ * pinv (Z₁ᴴ * Ω₁)) ^ 2 +
            4 * Real.exp (-3 * ((q₂ : ℝ) - 1)) *
              frobNorm ((A - truncatedSVD A (k + j)) * Ω₂ * pinv (Z₂ᴴ * Ω₂)) ^ 2) := by
  classical
  have hP := isStarProjection_rangeProjector (A * Y)
  have hdom₁ (i : ℕ) :
      singularValues (rbki A Ω₁ q₁) i ≤ singularValues (rangeProjector (A * Y) * A) i :=
    singularValues_rangeProjector_mul_le_of_range_le h₁ A i
  have hdom₂ (i : ℕ) :
      singularValues (rbki A Ω₂ q₂) i ≤ singularValues (rangeProjector (A * Y) * A) i :=
    singularValues_rangeProjector_mul_le_of_range_le h₂ A i
  have hs := Real.rpow_nonneg (singularValues_nonneg A k) (p.toReal - 2)
  have hO : 0 ≤ 2 * k * γ / ((j : ℝ) + 1) * schattenNorm p (A - truncatedSVD A k) ^ p.toReal :=
    mul_nonneg (by positivity) (Real.rpow_nonneg (schattenNorm_nonneg _ _) _)
  have hR₁ := mul_nonneg hs (show 0 ≤ 4 * k * Real.exp (-2 * Real.sqrt 2 * ((q₁ : ℝ) - 1) *
      Real.sqrt γ) * specNorm ((A - truncatedSVD A k) * Ω₁ * pinv (Z₁ᴴ * Ω₁)) ^ 2 by positivity)
  have hR₂ := mul_nonneg hs (show 0 ≤ 4 * Real.exp (-3 * ((q₂ : ℝ) - 1)) *
      frobNorm ((A - truncatedSVD A (k + j)) * Ω₂ * pinv (Z₂ᴴ * Ω₂)) ^ 2 by positivity)
  rw [rsvd, mul_add]
  rcases le_or_gt (singularValues A k) (Real.sqrt 2 * singularValues A (k + j)) with ht | ht
  · linarith [schattenNorm_sub_mul_rangeProjector_rpow_le_of_heavy hp1 hp2 hP hZ₁ hΩ₁ hAZ₁ hq₁
      hγ hγ1 hdom₁ ht]
  · linarith [schattenNorm_sub_mul_rangeProjector_rpow_le_of_gap hp1 hp2 hP hZ₂ hΩ₂ hAZ₂ hq₂
      hdom₂ ht]

omit [DecidableEq m] in
/-- **The Schatten error of block Krylov iteration on the sum of two block Krylov spaces,
$1 \le p \le 2$, two-sided output**: let $\mathbf{Z}_1$, $\mathbf{Z}_2$ be frames (orthonormal
columns) with
$\mathbf{A}\mathbf{Z}_1\mathbf{Z}_1^{\mathsf{H}} = \llbracket\mathbf{A}\rrbracket_k$,
$\mathbf{A}\mathbf{Z}_2\mathbf{Z}_2^{\mathsf{H}} = \llbracket\mathbf{A}\rrbracket_{k+j}$ and
$\operatorname{rank}(\mathbf{\Omega}_a^{\mathsf{H}}\mathbf{Z}_a) =
\operatorname{rank}\mathbf{Z}_a$ for $a = 1, 2$, let $q_1, q_2 \ge 1$ and $0 < \gamma \le 1$.
Write $\mathbf{B} = \llbracket\mathsf{rbkiSum}(\mathbf{A}, \mathbf{\Omega}_1, \mathbf{\Omega}_2,
q_1, q_2)\rrbracket_k$ and $\mathbf{P}_{\mathbf{B}^{\mathsf{H}}}$ for the projector onto its row
space. Then
$$\begin{aligned}
\|\mathbf{A} - \mathbf{A}\mathbf{P}_{\mathbf{B}^{\mathsf{H}}}\|_{S_p}^p \le{}&
\Bigl(1 + \frac{2k\gamma}{j + 1}\Bigr)
\|\mathbf{A} - \llbracket\mathbf{A}\rrbracket_k\|_{S_p}^p \\
&+ \sigma_k(\mathbf{A})^{p-2}\Bigl(4k\,e^{-2\sqrt{2}(q_1-1)\sqrt{\gamma}}\,
\|(\mathbf{A} - \llbracket\mathbf{A}\rrbracket_k)\mathbf{\Omega}_1
(\mathbf{Z}_1^{\mathsf{H}}\mathbf{\Omega}_1)^{+}\|_2^2 +
4e^{-3(q_2-1)}\,
\|(\mathbf{A} - \llbracket\mathbf{A}\rrbracket_{k+j})\mathbf{\Omega}_2
(\mathbf{Z}_2^{\mathsf{H}}\mathbf{\Omega}_2)^{+}\|_{\mathsf{F}}^2\Bigr)\,.
\end{aligned}$$
The instance of
`NLAlib.HasOrthonormalCols.schattenNorm_sub_mul_rangeProjector_rsvd_rpow_le_of_range_le` at the
two block Krylov test matrices side by side.
[BakshiClarksonWoodruff2022, Theorem 3.1]; there for an algorithm that selects one of the two
runs, with blocks of $k$ and $s$ columns, probability $9/10$ and unspecified constants; here
deterministic, for $1 \le p \le 2$ and the projection onto the sum of the two spaces, with the
two residuals explicit. -/
theorem HasOrthonormalCols.schattenNorm_sub_mul_rangeProjector_rbkiSum_rpow_le
    {p : ℝ≥0∞} (hp1 : 1 ≤ p) (hp2 : p ≤ 2)
    {A : Matrix m n 𝕜} {Ω₁ : Matrix n l₁ 𝕜} {Ω₂ : Matrix n l₂ 𝕜} {Z₁ : Matrix n s₁ 𝕜}
    {Z₂ : Matrix n s₂ 𝕜} (hZ₁ : HasOrthonormalCols Z₁) (hZ₂ : HasOrthonormalCols Z₂)
    (hΩ₁ : (Ω₁ᴴ * Z₁).rank = Z₁.rank) (hΩ₂ : (Ω₂ᴴ * Z₂).rank = Z₂.rank) {k j : ℕ}
    (hAZ₁ : A * Z₁ * Z₁ᴴ = truncatedSVD A k) (hAZ₂ : A * Z₂ * Z₂ᴴ = truncatedSVD A (k + j))
    {q₁ q₂ : ℕ} (hq₁ : 1 ≤ q₁) (hq₂ : 1 ≤ q₂) {γ : ℝ} (hγ : 0 < γ) (hγ1 : γ ≤ 1) :
    schattenNorm p (A - A * rangeProjector (truncatedSVD (rbkiSum A Ω₁ Ω₂ q₁ q₂) k)ᴴ) ^ p.toReal ≤
      (1 + 2 * k * γ / ((j : ℝ) + 1)) * schattenNorm p (A - truncatedSVD A k) ^ p.toReal +
        singularValues A k ^ (p.toReal - 2) *
          (4 * k * Real.exp (-2 * Real.sqrt 2 * ((q₁ : ℝ) - 1) * Real.sqrt γ) *
              specNorm ((A - truncatedSVD A k) * Ω₁ * pinv (Z₁ᴴ * Ω₁)) ^ 2 +
            4 * Real.exp (-3 * ((q₂ : ℝ) - 1)) *
              frobNorm ((A - truncatedSVD A (k + j)) * Ω₂ * pinv (Z₂ᴴ * Ω₂)) ^ 2) :=
  hZ₁.schattenNorm_sub_mul_rangeProjector_rsvd_rpow_le_of_range_le hp1 hp2 hZ₂ hΩ₁ hΩ₂ hAZ₁ hAZ₂
    hq₁ hq₂ hγ hγ1 (range_mul_blockKrylovMatrix_le_range_mul_fromCols_left A Ω₁ Ω₂ q₁ q₂)
    (range_mul_blockKrylovMatrix_le_range_mul_fromCols_right A Ω₁ Ω₂ q₁ q₂)

end NLAlib
