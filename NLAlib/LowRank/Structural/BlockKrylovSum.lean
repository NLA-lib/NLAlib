/-! ### Schatten norms, $1 \le p \le 2$ -/

omit [DecidableEq m] in
/-- **The Schatten error of a sketch containing two block Krylov sketches, $1 \le p \le 2$,
two-sided output**: let $\mathbf{Z}_1$, $\mathbf{Z}_2$ be frames (orthonormal columns) with
$\mathbf{A}\mathbf{Z}_1\mathbf{Z}_1^{\mathsf{H}} = \llbracket\mathbf{A}\rrbracket_k$,
$\mathbf{A}\mathbf{Z}_2\mathbf{Z}_2^{\mathsf{H}} = \llbracket\mathbf{A}\rrbracket_{k+j}$ and
$\operatorname{rank}(\mathbf{\Omega}_a^{\mathsf{H}}\mathbf{Z}_a) =
\operatorname{rank}\mathbf{Z}_a$ for $a = 1, 2$, let $q_1, q_2 \ge 1$ and $0 < \gamma \le 1$,
and let $\mathbf{Y}$ be a test matrix such that the range of $\mathbf{A}\mathbf{Y}$ contains the
ranges of $\mathbf{A}\mathbf{K}_{q_1}(\mathbf{A}^{\mathsf{H}}\mathbf{A}, \mathbf{\Omega}_1)$ and
of $\mathbf{A}\mathbf{K}_{q_2}(\mathbf{A}^{\mathsf{H}}\mathbf{A}, \mathbf{\Omega}_2)$. Write
$\mathbf{B} = \llbracket\mathsf{rsvd}(\mathbf{A}, \mathbf{Y})\rrbracket_k$ and
$\mathbf{P}_{\mathbf{B}^{\mathsf{H}}}$ for the projector onto its row space. Then
$$\begin{aligned}
\|\mathbf{A} - \mathbf{A}\mathbf{P}_{\mathbf{B}^{\mathsf{H}}}\|_{S_p}^p \le{}&
\Bigl(1 + \frac{2k\gamma}{j + 1}\Bigr)
\|\mathbf{A} - \llbracket\mathbf{A}\rrbracket_k\|_{S_p}^p \\
&+ \sigma_k(\mathbf{A})^{p-2}\Bigl(4k\,e^{-2\sqrt{2}(q_1-1)\sqrt{\gamma}}\,
\|(\mathbf{A} - \llbracket\mathbf{A}\rrbracket_k)\mathbf{\Omega}_1
(\mathbf{Z}_1^{\mathsf{H}}\mathbf{\Omega}_1)^{+}\|_2^2 +
4e^{-3(q_2-1)}\,
\|(\mathbf{A} - \llbracket\mathbf{A}\rrbracket_{k+j})\mathbf{\Omega}_2
(\mathbf{Z}_2^{\mathsf{H}}\mathbf{\Omega}_2)^{+}\|_{\mathsf{F}}^2\Bigr)\,.
\end{aligned}$$
The output $\mathbf{A}\mathbf{P}_{\mathbf{B}^{\mathsf{H}}}$ has rank at most $k$; for $p < 2$ the
bound is for this two-sided output, not for $\mathbf{B}$.
[BakshiClarksonWoodruff2022, Theorem 3.1]; there for an algorithm that selects one of the two
runs, with blocks of $k$ and $s$ columns, probability $9/10$ and unspecified constants; here
deterministic, for $1 \le p \le 2$ and any sketch containing both block Krylov sketches, with the
two residuals explicit. -/
theorem HasOrthonormalCols.schattenNorm_sub_mul_rangeProjector_rsvd_rpow_le_of_range_le
    {p : ℝ≥0∞} (hp1 : 1 ≤ p) (hp2 : p ≤ 2)
    {A : Matrix m n 𝕜} {Ω₁ : Matrix n l₁ 𝕜} {Ω₂ : Matrix n l₂ 𝕜} {Z₁ : Matrix n s₁ 𝕜}
    {Z₂ : Matrix n s₂ 𝕜} (hZ₁ : HasOrthonormalCols Z₁) (hZ₂ : HasOrthonormalCols Z₂)
    (hΩ₁ : (Ω₁ᴴ * Z₁).rank = Z₁.rank) (hΩ₂ : (Ω₂ᴴ * Z₂).rank = Z₂.rank) {k j : ℕ}
    (hAZ₁ : A * Z₁ * Z₁ᴴ = truncatedSVD A k) (hAZ₂ : A * Z₂ * Z₂ᴴ = truncatedSVD A (k + j))
    {q₁ q₂ : ℕ} (hq₁ : 1 ≤ q₁) (hq₂ : 1 ≤ q₂) {γ : ℝ} (hγ : 0 < γ) (hγ1 : γ ≤ 1)
    {Y : Matrix n l 𝕜}
    (h₁ : LinearMap.range (A * blockKrylovMatrix (Aᴴ * A) Ω₁ q₁).mulVecLin ≤
      LinearMap.range (A * Y).mulVecLin)
    (h₂ : LinearMap.range (A * blockKrylovMatrix (Aᴴ * A) Ω₂ q₂).mulVecLin ≤
      LinearMap.range (A * Y).mulVecLin) :
    schattenNorm p (A - A * rangeProjector (truncatedSVD (rsvd A Y) k)ᴴ) ^ p.toReal ≤
      (1 + 2 * k * γ / ((j : ℝ) + 1)) * schattenNorm p (A - truncatedSVD A k) ^ p.toReal +
        singularValues A k ^ (p.toReal - 2) *
          (4 * k * Real.exp (-2 * Real.sqrt 2 * ((q₁ : ℝ) - 1) * Real.sqrt γ) *
              specNorm ((A - truncatedSVD A k) * Ω₁ * pinv (Z₁ᴴ * Ω₁)) ^ 2 +
            4 * Real.exp (-3 * ((q₂ : ℝ) - 1)) *
              frobNorm ((A - truncatedSVD A (k + j)) * Ω₂ * pinv (Z₂ᴴ * Ω₂)) ^ 2) := sorry

omit [DecidableEq m] in
/-- **The Schatten error of block Krylov iteration on the sum of two block Krylov spaces,
$1 \le p \le 2$, two-sided output**: let $\mathbf{Z}_1$, $\mathbf{Z}_2$ be frames (orthonormal
columns) with
$\mathbf{A}\mathbf{Z}_1\mathbf{Z}_1^{\mathsf{H}} = \llbracket\mathbf{A}\rrbracket_k$,
$\mathbf{A}\mathbf{Z}_2\mathbf{Z}_2^{\mathsf{H}} = \llbracket\mathbf{A}\rrbracket_{k+j}$ and
$\operatorname{rank}(\mathbf{\Omega}_a^{\mathsf{H}}\mathbf{Z}_a) =
