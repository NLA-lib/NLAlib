module

public import NLAlib.Ops.Catalog.Orth
public import NLAlib.Ops.RoutineLink

/-!
# The interface of a basis extension

A basis extension at the dimensions `[n, k, b]` reads a basis of `k` columns and a block of `b`
columns, and writes the `b` new columns at the end of the basis, unspecified words over the
block, and the coefficients. As a routine (`NLAlib.Ops.extendRoutine`) it has four operands, of
which a call supplies three: the basis, the new columns, which continue the basis
(`NLAlib.Ops.Port.cont`), the block, updated in place, and the coefficients. Every tree with this
interface that meets the specification read off a contract of a basis extension implements the
operation `NLAlib.Ops.OrthOp.extend` with that contract.

## Main definitions

* `NLAlib.Ops.extendRoutine`: the interface, for a tree.
* `NLAlib.Ops.extendSpecOf`: the specification read off a contract of a basis extension.

## Main results

* `NLAlib.Ops.extendRoutine_implements`: the interface implements the contracts of a basis
  extension.
-/

@[expose] public section

namespace NLAlib.Ops

variable {K 𝕜 Op Tst : Type} [Inhabited K]

/-- **The interface of a basis extension**, for a tree: dimensions `[n, k, b]`; the basis `Q`
(`k * n` words, read), the new columns (`b * n` words, written, continuing the basis), the block
`W` (`b * n` words, updated in place) and the coefficients `C` (`(k + b) * b` words, written). A
call supplies `Q`, `W` and `C`. The buffer variables of the tree are `Q`, `W`, the new columns,
`W` and `C`: the inputs followed by the outputs of the operation.

The layout is written out, not generated by `routine%`: an operand continues the one just
before it in interface order, so the new columns must come directly after `Q`, while `routine%`
places the operands of the right side (the new columns) after those of the left (`Q`, `W`), where
they would continue `W`. -/
def extendRoutine (body : Stmt Op Tst) : Routine Op Tst :=
  { nd := 3
    ports := [.read (fun d => d.getD 1 0 * d.headD 0),
      (Port.write (fun d => d.getD 2 0 * d.headD 0)).continuing,
      .update (fun d => d.getD 2 0 * d.headD 0),
      .write (fun d => (d.getD 1 0 + d.getD 2 0) * d.getD 2 0)]
    body := body
    binds := some [0, 2, 1, 2, 3] }

/-- The specification of a basis extension for the predicate `P` on the decoded matrices, at
the dimensions admitted by `ok`: that of the contract `NLAlib.Ops.extendRelOf`. -/
abbrev extendSpecOf (dec : K → 𝕜) (ok : ℕ → ℕ → ℕ → Prop) (P : ExtendPred 𝕜) : Routine.Spec K :=
  Routine.Spec.ofRel (extendRelOf dec ok P) fun _ => True

omit [Inhabited K] in
/-- The supplied operands of a basis extension are separated when the basis, the block and the
coefficients are in three different buffers; the new columns are in the buffer of the basis. -/
theorem extendRoutine_separated (body : Stmt Op Tst) (d : List ℕ) {Q W C : ℕ × ℕ}
    (hQW : Q.1 ≠ W.1) (hQC : Q.1 ≠ C.1) (hWC : W.1 ≠ C.1) :
    (extendRoutine body).SeparatedAt d [Q, W, C] := by
  change (extendRoutine body).regions.Separated [Q, W, C]
  refine ⟨?_, ?_, ?_, ?_⟩
  · simpa [extendRoutine, Routine.sel, Access.writable, Access.join, Access.readable,
      Access.isIsolated] using ⟨⟨hQW, hQC⟩, hWC⟩
  · simp [extendRoutine, Routine.sel, Access.writable, Access.readOnly, Access.join,
      Access.readable, Access.isIsolated]
  · simp [extendRoutine, Routine.sel, Access.writable, Access.join, Access.readable,
      Access.isIsolated]
  · simp [extendRoutine, Routine.sel, Access.writable, Access.join, Access.readable,
      Access.isIsolated]

/-- The operands admitted by `NLAlib.Ops.ExtendOperands`: the inputs are a basis `Q` and a
block `W`, and the outputs are the new columns, placed at the end of `Q` at the dimensions
`[n, k, b]`, then `W` and the coefficients `C`; the three buffers are different. The new columns
are not an independent operand, which is why `implements` (which names every operand) does not
apply to a basis extension. -/
theorem extendOperands_of_shaped {dec : K → 𝕜} {ok : ℕ → ℕ → ℕ → Prop} {P : ExtendPred 𝕜}
    {d : List ℕ} {ins outs : List (ℕ × ℕ)}
    (h : (extendRelOf dec ok P).Shaped ExtendOperands d ins outs) :
    ∃ Q W C, ins = [Q, W] ∧ outs = [(Q.1, Q.2 + d.getD 1 0 * d.headD 0), W, C] ∧
      Q.1 ≠ W.1 ∧ Q.1 ≠ C.1 ∧ W.1 ≠ C.1 := by
  obtain ⟨-, ⟨Q, W, C, rfl, rfl, h⟩, -, -⟩ := h
  exact ⟨Q, W, C, rfl, rfl, h⟩

/-- The interface of a basis extension implements its contracts: at the admitted operands
of `NLAlib.Ops.ExtendOperands`, the supplied operands are the basis, the block and the
coefficients; the new columns are where the contract puts them, at the end of the basis. -/
theorem extendRoutine_implements (body : Stmt Op Tst) (dec : K → 𝕜)
    (ok : ℕ → ℕ → ℕ → Prop) (P : ExtendPred 𝕜) :
    (extendRoutine body).Implements (extendRelOf dec ok P) ExtendOperands
      (fun ins outs => ins ++ outs.drop 2) := by
  refine Routine.Implements.of_shaped rfl (fun _ => rfl) fun d ins outs h => ?_
  obtain ⟨Q, W, C, rfl, rfl, hQW, hQC, hWC⟩ := extendOperands_of_shaped h
  refine ⟨⟨rfl, rfl⟩, rfl, ?_, extendRoutine_separated body d hQW hQC hWC, rfl, ⟨rfl, rfl⟩,
    ⟨rfl, rfl⟩⟩
  intro z hz
  have hz' : z = Q ∨ z = W ∨ z = C := by simpa using hz
  rcases hz' with rfl | rfl | rfl <;> simp

end NLAlib.Ops
