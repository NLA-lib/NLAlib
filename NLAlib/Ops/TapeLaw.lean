/-!
# The law of the tape

A tape `τ : Tape K` holds, at each position, one entry of each stream. Its law is a product: all
entries are independent and an entry of the stream `s` has the law `law s`
(`NLAlib.Ops.IsTapeLaw`, for a sample space `Ω` and a random tape `ξ : Ω → Tape K`; the
interpretation of a program is fixed before the sample). No program occurs in this file.

The filtration is the one of the positions: `NLAlib.Ops.Tape.past ξ p` is generated by the entries
at the positions below `p`. A run that has reached the position `p` under tape-local operations
is a function of those entries, so every quantity the algorithm has seen is measurable with
respect to it, and so is the hidden noise of earlier operations.

## Main results

* `NLAlib.Ops.IsTapeLaw.indepFun_of_measurable`: functions of entries at disjoint sets of
  positions are independent.
* `NLAlib.Ops.IsTapeLaw.map_windowFn`: a window of `k` entries of the stream `s` has the law
  `Measure.pi fun _ => law s`.
* `NLAlib.Ops.IsTapeLaw.integral_future` (**the conditional law of a window**), with
  `integral_window`, `integral_entry`: for `X` measurable with respect to the past of `p` and `W`
  a function of the entries from `p` on, `𝔼 φ(X, W) = 𝔼 ψ(X)` with `ψ x = ∫ φ(x, w) d(law of W)`.
  `integrable_future` is the integrability that goes with it, and `condExp_future` the same
  statement as a conditional expectation given the past.
* `NLAlib.Ops.IsTapeLaw.integral_hidden`: the form for an operation with hidden randomness whose
  output is `N x w`: given the history the output has the law `NLAlib.Ops.condLaw μ N x`.
* `NLAlib.Ops.exists_isTapeLaw`: every family of probability laws is the law of a tape.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory

namespace NLAlib.Ops

variable {K Ω : Type} [MeasurableSpace K]

namespace Tape

/-- The window of `k` entries of the stream `s` from the position `p`, as a vector. -/
def windowFn (τ : Tape K) (s p k : ℕ) : Fin k → K := fun j => τ (p + j) s

/-- The σ-algebra generated by the entries of the random tape `ξ` at the positions in `S`, in
all streams. -/
abbrev sigma (ξ : Ω → Tape K) (S : Set ℕ) : MeasurableSpace Ω :=
  ⨆ c ∈ {c : ℕ × ℕ | c.1 ∈ S}, MeasurableSpace.comap (fun ω => ξ ω c.1 c.2) inferInstance

/-- **The past of the position `p`**: the σ-algebra generated by the entries below `p`. -/
abbrev past (ξ : Ω → Tape K) (p : ℕ) : MeasurableSpace Ω := sigma ξ (Set.Iio p)

variable {ξ : Ω → Tape K}

theorem sigma_mono {S T : Set ℕ} (h : S ⊆ T) : sigma ξ S ≤ sigma ξ T :=
  biSup_mono fun _ hc => h hc

theorem past_mono {p q : ℕ} (h : p ≤ q) : past ξ p ≤ past ξ q :=
  sigma_mono (Set.Iio_subset_Iio h)

/-- An entry at a position of `S` is measurable with respect to the entries at `S`. -/
theorem measurable_entry {S : Set ℕ} {i : ℕ} (hi : i ∈ S) (s : ℕ) :
    Measurable[sigma ξ S] fun ω => ξ ω i s :=
  Measurable.of_comap_le (le_biSup (fun c : ℕ × ℕ =>
    MeasurableSpace.comap (fun ω => ξ ω c.1 c.2) inferInstance)
    (show (i, s) ∈ {c : ℕ × ℕ | c.1 ∈ S} from hi))

/-- A window inside `S` is measurable with respect to the entries at `S`. -/
theorem measurable_windowFn {S : Set ℕ} {p k : ℕ} (h : ∀ j < k, p + j ∈ S) (s : ℕ) :
    Measurable[sigma ξ S] fun ω => windowFn (ξ ω) s p k :=
  @measurable_pi_lambda _ _ _ (sigma ξ S) _ _ fun j => measurable_entry (h j j.2) s

/-- A window before `q` is measurable with respect to the past of `q`. -/
theorem measurable_windowFn_past {p k q : ℕ} (h : p + k ≤ q) (s : ℕ) :
    Measurable[past ξ q] fun ω => windowFn (ξ ω) s p k :=
  measurable_windowFn (fun j hj => Set.mem_Iio.mpr (by omega)) s

/-- A window from `p` on is measurable with respect to the entries from `p` on. -/
theorem measurable_windowFn_future (s p k : ℕ) :
    Measurable[sigma ξ (Set.Ici p)] fun ω => windowFn (ξ ω) s p k :=
  measurable_windowFn (fun j _ => Set.mem_Ici.mpr (by omega)) s

end Tape

/-- **The law of the tape.** The entries of the random tape `ξ` are measurable and independent,
and an entry of the stream `s` has the law `law s`. -/
structure IsTapeLaw {mΩ : MeasurableSpace Ω} (law : ℕ → Measure K) (P : Measure Ω)
    (ξ : Ω → Tape K) : Prop where
  /-- The entries are measurable. -/
  measurable : ∀ i s, Measurable fun ω => ξ ω i s
  /-- The entries are independent. -/
  indep : iIndepFun (fun (c : ℕ × ℕ) ω => ξ ω c.1 c.2) P
  /-- An entry of the stream `s` has the law `law s`. -/
  map : ∀ i s, P.map (fun ω => ξ ω i s) = law s

/-! ### Independent pairs: the two forms of Fubini's theorem used below -/

section Pair

variable {mΩ : MeasurableSpace Ω} {α β : Type} [MeasurableSpace α] [MeasurableSpace β]
  {P : Measure Ω} [IsProbabilityMeasure P] {X : Ω → α} {W : Ω → β} {φ : α → β → ℝ}

/-- Integrability of a function of an independent pair, from the inner and the outer integral. -/
theorem integrable_comp_of_indepFun (hXW : IndepFun X W P) (hX : Measurable X)
    (hW : Measurable W) (hφ : Measurable (Function.uncurry φ))
    (h1 : ∀ x, Integrable (φ x) (P.map W))
    (h2 : Integrable (fun ω => ∫ w, ‖φ (X ω) w‖ ∂(P.map W)) P) :
    Integrable (fun ω => φ (X ω) (W ω)) P := by
  have hmap := (indepFun_iff_map_prod_eq_prod_map_map hX.aemeasurable hW.aemeasurable).mp hXW
  have hprod : Integrable (Function.uncurry φ) ((P.map X).prod (P.map W)) := by
    rw [integrable_prod_iff hφ.aestronglyMeasurable]
    exact ⟨Filter.Eventually.of_forall h1, (integrable_map_measure
      hφ.norm.stronglyMeasurable.integral_prod_right.aestronglyMeasurable hX.aemeasurable).mpr h2⟩
  rw [← hmap] at hprod
  exact (integrable_map_measure hφ.aestronglyMeasurable (hX.prodMk hW).aemeasurable).mp hprod

/-- The integral of a function of an independent pair: integrate the second variable out. -/
theorem integral_comp_of_indepFun (hXW : IndepFun X W P) (hX : Measurable X) (hW : Measurable W)
    (hφ : Measurable (Function.uncurry φ)) (hint : Integrable (fun ω => φ (X ω) (W ω)) P) :
    ∫ ω, φ (X ω) (W ω) ∂P = ∫ ω, ∫ w, φ (X ω) w ∂(P.map W) ∂P := by
  have hmap := (indepFun_iff_map_prod_eq_prod_map_map hX.aemeasurable hW.aemeasurable).mp hXW
  have hprod : Integrable (Function.uncurry φ) ((P.map X).prod (P.map W)) := by
    rw [← hmap]
    exact (integrable_map_measure hφ.aestronglyMeasurable (hX.prodMk hW).aemeasurable).mpr hint
  calc ∫ ω, φ (X ω) (W ω) ∂P
      = ∫ z, Function.uncurry φ z ∂(P.map fun ω => (X ω, W ω)) :=
        (integral_map (hX.prodMk hW).aemeasurable hφ.aestronglyMeasurable).symm
    _ = ∫ x, ∫ w, φ x w ∂(P.map W) ∂(P.map X) := by
        rw [hmap, integral_prod _ hprod]
        rfl
    _ = ∫ ω, ∫ w, φ (X ω) w ∂(P.map W) ∂P :=
        integral_map hX.aemeasurable
          hφ.stronglyMeasurable.integral_prod_right.aestronglyMeasurable

/-- The inner integral of a function of an independent pair is integrable. -/
theorem integrable_integral_of_indepFun (hXW : IndepFun X W P) (hX : Measurable X)
    (hW : Measurable W) (hφ : Measurable (Function.uncurry φ))
    (hint : Integrable (fun ω => φ (X ω) (W ω)) P) :
    Integrable (fun ω => ∫ w, φ (X ω) w ∂(P.map W)) P := by
  have hmap := (indepFun_iff_map_prod_eq_prod_map_map hX.aemeasurable hW.aemeasurable).mp hXW
  have hprod : Integrable (Function.uncurry φ) ((P.map X).prod (P.map W)) := by
    rw [← hmap]
    exact (integrable_map_measure hφ.aestronglyMeasurable (hX.prodMk hW).aemeasurable).mpr hint
  exact (integrable_map_measure
    hφ.stronglyMeasurable.integral_prod_right.aestronglyMeasurable hX.aemeasurable).mp
    hprod.integral_prod_left

end Pair

namespace IsTapeLaw

variable {mΩ : MeasurableSpace Ω} {law : ℕ → Measure K} {P : Measure Ω} {ξ : Ω → Tape K}

theorem isProbabilityMeasure (h : IsTapeLaw law P ξ) : IsProbabilityMeasure P :=
  h.indep.isProbabilityMeasure

/-- The law of a stream is a probability measure. -/
theorem isProbabilityMeasure_law (h : IsTapeLaw law P ξ) (s : ℕ) :
    IsProbabilityMeasure (law s) := by
  have := h.isProbabilityMeasure
  rw [← h.map 0 s]
  exact Measure.isProbabilityMeasure_map (h.measurable 0 s).aemeasurable

theorem sigma_le (h : IsTapeLaw law P ξ) (S : Set ℕ) : Tape.sigma ξ S ≤ mΩ :=
  iSup₂_le fun c _ => (h.measurable c.1 c.2).comap_le

/-- The entries at disjoint sets of positions generate independent σ-algebras. -/
theorem indep_sigma (h : IsTapeLaw law P ξ) {S T : Set ℕ} (hST : Disjoint S T) :
    Indep (Tape.sigma ξ S) (Tape.sigma ξ T) P :=
  indep_iSup_of_disjoint (m := fun c : ℕ × ℕ =>
    MeasurableSpace.comap (fun ω => ξ ω c.1 c.2) inferInstance)
    (fun c => (h.measurable c.1 c.2).comap_le) h.indep
    (Set.disjoint_left.mpr fun _ hS hT => Set.disjoint_left.mp hST hS hT)

/-- **Functions of the entries at disjoint sets of positions are independent.** -/
theorem indepFun_of_measurable (h : IsTapeLaw law P ξ) {S T : Set ℕ} (hST : Disjoint S T)
    {α β : Type} [MeasurableSpace α] [MeasurableSpace β] {X : Ω → α} {W : Ω → β}
    (hX : Measurable[Tape.sigma ξ S] X) (hW : Measurable[Tape.sigma ξ T] W) : IndepFun X W P :=
  indep_of_indep_of_le_left (indep_of_indep_of_le_right (h.indep_sigma hST) hW.comap_le)
    hX.comap_le

/-- **The law of a window**: `k` entries of the stream `s` are independent draws of `law s`. -/
theorem map_windowFn (h : IsTapeLaw law P ξ) (s p k : ℕ) :
    P.map (fun ω => Tape.windowFn (ξ ω) s p k) = Measure.pi fun _ : Fin k => law s := by
  have := h.isProbabilityMeasure
  have hind : iIndepFun (fun (j : Fin k) ω => ξ ω (p + j) s) P :=
    h.indep.precomp (g := fun j : Fin k => (p + (j : ℕ), s)) fun a b hab => by
      simpa [Fin.ext_iff] using hab
  have := (iIndepFun_iff_map_fun_eq_pi_map fun j => (h.measurable _ _).aemeasurable).mp hind
  simp only [h.map] at this
  exact this

/-- The filtration of the positions. -/
def filtration (h : IsTapeLaw law P ξ) : Filtration ℕ mΩ where
  seq p := Tape.past ξ p
  mono' _ _ hpq := Tape.past_mono hpq
  le' _ := h.sigma_le _

variable {α β : Type} [MeasurableSpace α] [MeasurableSpace β] {X : Ω → α} {W : Ω → β} {p : ℕ}
  {φ : α → β → ℝ}

/-- A function of the past and a function of the entries from `p` on are independent. -/
theorem indepFun_past_future (h : IsTapeLaw law P ξ) (hX : Measurable[Tape.past ξ p] X)
    (hW : Measurable[Tape.sigma ξ (Set.Ici p)] W) : IndepFun X W P :=
  h.indepFun_of_measurable (Set.disjoint_left.mpr fun _ h1 h2 =>
    absurd (Set.mem_Iio.mp h1) (not_lt.mpr (Set.mem_Ici.mp h2))) hX hW

/-- **The conditional law of what is drawn from the position `p` on, given the past**: for `X`
a function of the past and `W` a function of the entries from `p` on, the expectation of
`φ(X, W)` is the expectation of `ψ(X)`, where `ψ x` integrates `φ(x, ·)` against the law of
`W`. The past does not change the law of `W`. -/
theorem integral_future (h : IsTapeLaw law P ξ) (hX : Measurable[Tape.past ξ p] X)
    (hW : Measurable[Tape.sigma ξ (Set.Ici p)] W) (hφ : Measurable (Function.uncurry φ))
    (hint : Integrable (fun ω => φ (X ω) (W ω)) P) :
    ∫ ω, φ (X ω) (W ω) ∂P = ∫ ω, ∫ w, φ (X ω) w ∂(P.map W) ∂P :=
  have := h.isProbabilityMeasure
  integral_comp_of_indepFun (h.indepFun_past_future hX hW) (hX.mono (h.sigma_le _) le_rfl)
    (hW.mono (h.sigma_le _) le_rfl) hφ hint

/-- The integrability that goes with `integral_future`. -/
theorem integrable_future (h : IsTapeLaw law P ξ) (hX : Measurable[Tape.past ξ p] X)
    (hW : Measurable[Tape.sigma ξ (Set.Ici p)] W) (hφ : Measurable (Function.uncurry φ))
    (h1 : ∀ x, Integrable (φ x) (P.map W))
    (h2 : Integrable (fun ω => ∫ w, ‖φ (X ω) w‖ ∂(P.map W)) P) :
    Integrable (fun ω => φ (X ω) (W ω)) P :=
  have := h.isProbabilityMeasure
  integrable_comp_of_indepFun (h.indepFun_past_future hX hW) (hX.mono (h.sigma_le _) le_rfl)
    (hW.mono (h.sigma_le _) le_rfl) hφ h1 h2

/-- `integral_future` for a window of `k` entries of the stream `s` at the position `p`. -/
theorem integral_window (h : IsTapeLaw law P ξ) (hX : Measurable[Tape.past ξ p] X) (s k : ℕ)
    {φ : α → (Fin k → K) → ℝ} (hφ : Measurable (Function.uncurry φ))
    (hint : Integrable (fun ω => φ (X ω) (Tape.windowFn (ξ ω) s p k)) P) :
    ∫ ω, φ (X ω) (Tape.windowFn (ξ ω) s p k) ∂P =
      ∫ ω, ∫ w, φ (X ω) w ∂(Measure.pi fun _ : Fin k => law s) ∂P := by
  rw [h.integral_future hX (Tape.measurable_windowFn_future s p k) hφ hint, h.map_windowFn]

/-- `integrable_future` for a window. -/
theorem integrable_window (h : IsTapeLaw law P ξ) (hX : Measurable[Tape.past ξ p] X) (s k : ℕ)
    {φ : α → (Fin k → K) → ℝ} (hφ : Measurable (Function.uncurry φ))
    (h1 : ∀ x, Integrable (φ x) (Measure.pi fun _ : Fin k => law s))
    (h2 : Integrable (fun ω => ∫ w, ‖φ (X ω) w‖ ∂(Measure.pi fun _ : Fin k => law s)) P) :
    Integrable (fun ω => φ (X ω) (Tape.windowFn (ξ ω) s p k)) P :=
  h.integrable_future hX (Tape.measurable_windowFn_future s p k) hφ
    (by rwa [h.map_windowFn]) (by rwa [h.map_windowFn])

/-- `integral_future` for the entry of the stream `s` at the position `p`. -/
theorem integral_entry (h : IsTapeLaw law P ξ) (hX : Measurable[Tape.past ξ p] X) (s : ℕ)
    {φ : α → K → ℝ} (hφ : Measurable (Function.uncurry φ))
    (hint : Integrable (fun ω => φ (X ω) (ξ ω p s)) P) :
    ∫ ω, φ (X ω) (ξ ω p s) ∂P = ∫ ω, ∫ x, φ (X ω) x ∂(law s) ∂P := by
  rw [h.integral_future hX (Tape.measurable_entry (Set.mem_Ici.mpr le_rfl) s) hφ hint, h.map]

/-- **The conditional law of the output of an operation with hidden randomness**, given its
input `x`: the law of `N x w` when the window `w` is `k` fresh draws of `μ`. -/
noncomputable def _root_.NLAlib.Ops.condLaw (μ : Measure K) {k : ℕ} (N : α → (Fin k → K) → β)
    (x : α) : Measure β :=
  (Measure.pi fun _ : Fin k => μ).map (N x)

/-- **Given the history, the output of a hidden-randomness operation has its conditional law.**
The operation is called at the position `p` on an input `X` that is any function of the past;
its output is `N X w` with `w` its own window. Then the expectation of `φ(X, output)` is the
expectation of `∫ φ(X, y) d(condLaw μ N X)(y)`: nothing in the past changes the law of the
output given the input. -/
theorem integral_hidden (h : IsTapeLaw law P ξ) (hX : Measurable[Tape.past ξ p] X) (s : ℕ)
    {k : ℕ} {N : α → (Fin k → K) → β} (hN : Measurable (Function.uncurry N))
    (hφ : Measurable (Function.uncurry φ))
    (hint : Integrable (fun ω => φ (X ω) (N (X ω) (Tape.windowFn (ξ ω) s p k))) P) :
    ∫ ω, φ (X ω) (N (X ω) (Tape.windowFn (ξ ω) s p k)) ∂P =
      ∫ ω, ∫ y, φ (X ω) y ∂(condLaw (law s) N (X ω)) ∂P := by
  rw [h.integral_window hX s k (φ := fun x w => φ x (N x w))
    (hφ.comp (measurable_fst.prodMk hN)) hint]
  refine integral_congr_ae (Filter.Eventually.of_forall fun ω => ?_)
  exact (integral_map (hN.comp (measurable_const.prodMk measurable_id)).aemeasurable
    (hφ.comp (measurable_const.prodMk measurable_id)).aestronglyMeasurable).symm

/-- The integrability that goes with `integral_hidden`. -/
theorem integrable_hidden (h : IsTapeLaw law P ξ) (hX : Measurable[Tape.past ξ p] X) (s : ℕ)
    {k : ℕ} {N : α → (Fin k → K) → β} (hN : Measurable (Function.uncurry N))
    (hφ : Measurable (Function.uncurry φ))
    (h1 : ∀ x, Integrable (φ x) (condLaw (law s) N x))
    (h2 : Integrable (fun ω => ∫ y, ‖φ (X ω) y‖ ∂(condLaw (law s) N (X ω))) P) :
    Integrable (fun ω => φ (X ω) (N (X ω) (Tape.windowFn (ξ ω) s p k))) P := by
  have hNx : ∀ x, Measurable (N x) := fun x => hN.comp (measurable_const.prodMk measurable_id)
  have hφx : ∀ x, Measurable (φ x) := fun x => hφ.comp (measurable_const.prodMk measurable_id)
  refine h.integrable_window hX s k (φ := fun x w => φ x (N x w))
    (hφ.comp (measurable_fst.prodMk hN)) (fun x =>
      (integrable_map_measure (hφx x).aestronglyMeasurable (hNx x).aemeasurable).mp (h1 x)) ?_
  refine h2.congr (Filter.Eventually.of_forall fun ω => ?_)
  exact integral_map (hNx _).aemeasurable (hφx _).norm.aestronglyMeasurable

/-- **The same statement as a conditional expectation**: given the past of `p`, the expectation
of `φ(X, W)` is `ψ(X)`. -/
theorem condExp_future (h : IsTapeLaw law P ξ) (hX : Measurable[Tape.past ξ p] X)
    (hW : Measurable[Tape.sigma ξ (Set.Ici p)] W) (hφ : Measurable (Function.uncurry φ))
    (hint : Integrable (fun ω => φ (X ω) (W ω)) P) :
    P[fun ω => φ (X ω) (W ω) | Tape.past ξ p] =ᵐ[P] fun ω => ∫ w, φ (X ω) w ∂(P.map W) := by
  have := h.isProbabilityMeasure
  have hXm := hX.mono (h.sigma_le _) le_rfl
  have hWm := hW.mono (h.sigma_le _) le_rfl
  have hind := h.indepFun_past_future hX hW
  have hg := integrable_integral_of_indepFun hind hXm hWm hφ hint
  have hψ : Measurable fun x => ∫ w, φ x w ∂(P.map W) :=
    hφ.stronglyMeasurable.integral_prod_right.measurable
  refine (ae_eq_condExp_of_forall_setIntegral_eq (h.sigma_le _) hint
    (fun _ _ _ => hg.integrableOn) (fun S hS _ => ?_) ?_).symm
  · -- the indicator of a past event is a function of the past
    have hS' : MeasurableSet S := h.sigma_le _ S hS
    let c : Ω → ℝ := S.indicator fun _ => 1
    have hc : Measurable[Tape.past ξ p] c := by
      let _ := Tape.past ξ p
      exact measurable_const.indicator hS
    have hφ' : Measurable (Function.uncurry fun (z : α × ℝ) (w : β) => z.2 * φ z.1 w) :=
      (measurable_snd.comp measurable_fst).mul
        (hφ.comp ((measurable_fst.comp measurable_fst).prodMk measurable_snd))
    have e : ∀ f : Ω → ℝ, ∫ ω in S, f ω ∂P = ∫ ω, c ω * f ω ∂P := fun f => by
      rw [← integral_indicator hS']
      refine integral_congr_ae (Filter.Eventually.of_forall fun ω => ?_)
      by_cases hω : ω ∈ S <;> simp [c, hω]
    have key := h.integral_future (X := fun ω => (X ω, c ω)) (hX.prodMk hc) hW hφ' (by
      refine (hint.indicator hS').congr (Filter.Eventually.of_forall fun ω => ?_)
      by_cases hω : ω ∈ S <;> simp [c, hω])
    rw [e, e, key]
    exact integral_congr_ae (Filter.Eventually.of_forall fun ω => (integral_const_mul _ _).symm)
  · have : StronglyMeasurable[Tape.past ξ p] fun ω => ∫ w, φ (X ω) w ∂(P.map W) := by
      let _ := Tape.past ξ p
      exact (hψ.comp hX).stronglyMeasurable
    exact this.aestronglyMeasurable

end IsTapeLaw

/-- **Every family of probability laws is the law of a tape.** -/
theorem exists_isTapeLaw (law : ℕ → Measure K) [∀ s, IsProbabilityMeasure (law s)] :
    ∃ (Ω : Type) (_ : MeasurableSpace Ω) (P : Measure Ω) (ξ : Ω → Tape K), IsTapeLaw law P ξ := by
  obtain ⟨Ω, mΩ, P, X, hm, hl, hi, -⟩ :=
    exists_hasLaw_indepFun (fun _ : ℕ × ℕ => K) (fun c => law c.2)
  exact ⟨Ω, mΩ, P, fun ω i s => X (i, s) ω, fun i s => hm (i, s), hi, fun i s => (hl (i, s)).map_eq⟩

end NLAlib.Ops
