import NLAlib
import Batteries.Tactic.Lint

/-! # Environment linters

Run the complete standard environment-linter set on imported NLAlib declarations.
The simp-normal-form adapter recognizes only compiler-owned constructor injectivity facts
whose two equality propositions are already reflexive by definitional equality. Such facts
are generated for singleton constructor arguments; neither the algorithm API nor the global
simp set needs changing to remove their redundant lint reports. All other simp lemmas still
use Batteries' original test. The checker regressions below run on every invocation.
-/

open Lean Meta Elab Command Batteries.Tactic.Lint

namespace EnvironmentLint

/-- An equality whose operands coincide by reduction, without invoking simp lemmas. -/
def reflexiveEquality (e : Expr) : MetaM Bool := do
  let some (_, lhs, rhs) := e.eq? | return false
  withReducible <| isDefEq lhs rhs

/-- The compiler's injectivity fact for a constructor with definitionally singleton arguments.
The origin and the two reflexive equalities are both required; a user-authored redundant simp
lemma, or an ordinary constructor injectivity fact, is not exempted. -/
def reflexiveConstructorInjectivity (name : Name) : MetaM Bool := do
  let env ← getEnv
  let .str ctor "injEq" := name | return false
  unless env.isConstructor ctor && env.isAutoDecl name do return false
  let some (.thmInfo info) := env.find? name | return false
  forallTelescope info.type fun _ body => do
    let some (_, lhs, rhs) := body.eq? | return false
    unless ← reflexiveEquality lhs do return false
    reflexiveEquality rhs

/-- Preserve the upstream test except for its redundant generated singleton facts. -/
def simpNormalForm (name : Name) : MetaM (Option MessageData) := do
  if ← reflexiveConstructorInjectivity name then return none
  Batteries.Tactic.Lint.simpNF.test name

end EnvironmentLint

namespace EnvironmentLintFixtures

/-- A singleton tag, as used by operation catalogs. -/
inductive Tag where
  | only

/-- A constructor wrapping that tag, alongside another operation. -/
inductive TaggedOperation where
  | tagged (tag : Tag)
  | other

/-- An ordinary constructor whose natural-number argument is not a singleton. -/
inductive IndexedOperation where
  | indexed (index : Nat)
  | other

section

/-- The same redundant statement authored by a user, rather than generated by Lean. -/
theorem authoredTagEquality (a b : Tag) :
    (TaggedOperation.tagged a = TaggedOperation.tagged b) = (a = b) := by
  simp only

/-- An ordinary duplicate of an existing simplification theorem. -/
theorem duplicateZeroAdd (n : Nat) : 0 + n = n := Nat.zero_add n

attribute [local simp 100] authoredTagEquality duplicateZeroAdd

run_cmd do
  liftTermElabM do
    unless ← EnvironmentLint.reflexiveConstructorInjectivity
        ``TaggedOperation.tagged.injEq do
      throwError "singleton constructor injectivity fixture was not recognized"
    unless (← EnvironmentLint.simpNormalForm ``TaggedOperation.tagged.injEq).isNone do
      throwError "singleton constructor injectivity fixture was incorrectly reported"
    if ← EnvironmentLint.reflexiveConstructorInjectivity
        ``IndexedOperation.indexed.injEq then
      throwError "ordinary constructor injectivity must not be exempted"
    unless (← EnvironmentLint.simpNormalForm ``IndexedOperation.indexed.injEq).isNone do
      throwError "ordinary constructor injectivity should pass the original simpNF check"
    if ← EnvironmentLint.reflexiveConstructorInjectivity ``authoredTagEquality then
      throwError "a user theorem with the same type must not be exempted"
    unless (← EnvironmentLint.simpNormalForm ``authoredTagEquality).isSome do
      throwError "the authored redundant tag equality was not rejected"
    unless (← EnvironmentLint.simpNormalForm ``duplicateZeroAdd).isSome do
      throwError "the duplicate user simp theorem was not rejected"
  logInfo "environment lint fixtures: singleton generation, ordinary injectivity and user redundancy passed"

end
end EnvironmentLintFixtures

run_cmd do
  let env ← getEnv
  -- The support code and fixtures belong to this script, not the mathematical library.
  let decls := (← liftCoreM getAllDecls).filter fun name =>
    match env.getModuleIdxFor? name with
    | none => false
    | some i => (`NLAlib).isPrefixOf env.header.moduleNames[i.toNat]!
  let reflexiveFacts ← decls.filterM fun name =>
    liftTermElabM <| EnvironmentLint.reflexiveConstructorInjectivity name
  logInfo m!"simpNF: {reflexiveFacts.size} definitionally reflexive generated constructor facts: {
    reflexiveFacts}"
  let linters := (← liftCoreM <| getChecks true none none).map fun linter =>
    if linter.declName == ``Batteries.Tactic.Lint.simpNF then
      { linter with test := EnvironmentLint.simpNormalForm }
    else linter
  let results ← liftCoreM <| lintCore decls linters
  let message ← liftCoreM <| formatLinterResults results decls true "in NLAlib" true
    .medium linters.size
  if results.any (!·.2.isEmpty) then throwError message
  logInfo message
